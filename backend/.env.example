APP_ENV=local
LEGACY_ROOT=D:\Trading System\Trading_bot

# Official Kite Connect app credentials (from https://developers.kite.trade/apps).
# Used directly by Module D (Historical Extractor). Currently also kept in
# Trading_bot/_archive/other_bot_projects/new_trade_tool/.env -- copied here
# rather than reached-into, since that path has already moved once (see that
# file's config.py) and Module D shouldn't depend on it staying put.
KITE_API_KEY=
KITE_API_SECRET=

# NOT set here on purpose: TRUEDATA_AUTH_TOKEN and OPENAI_API_KEY stay defined
# only in Trading_bot/.env (the legacy root) and are loaded from there at
# runtime via app.core.legacy_path.load_legacy_env() -- see Module A. Keeping
# them single-sourced there means refreshing TRUEDATA_AUTH_TOKEN (it expires --
# see announcement_listener_v2.py's docstring) only ever has to happen in one
# file.
